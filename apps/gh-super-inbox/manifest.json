{
  "manifest_version": 3,
  "name": "GitHub Super Inbox",
  "version": "0.1.0",
  "description": "On github.com/notifications: shows why each PR is still in your inbox, highlights PRs that merged after you approved them, and selects those in one click.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "GitHub Super Inbox settings" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
